# Ambiente local de desenvolvimento. Não usar credenciais de demonstração em produção.
NEXO_DEMO=1
NEXO_DB_PATH=./data/nexo-alpha.sqlite3

# Em HTTPS definir 1 (requer TLS); em ambiente local HTTP usar 0.
NEXO_SECURE_COOKIES=0
# Obrigatório em produção, valor secreto e estável entre processos (gerar por gerenciador de segredos).
NEXO_RATE_LIMIT_SECRET=
# Administrador autorizado a consultar pedidos de demonstração da plataforma.
NEXO_LEADS_ADMIN_EMAIL=
